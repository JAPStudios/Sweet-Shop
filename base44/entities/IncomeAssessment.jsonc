{
  "name": "IncomeAssessment",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "default": "butter_bank"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "verified",
        "declined",
        "expired"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "default": "requested"
    },
    "reference": {
      "type": "string",
      "description": "Reference returned by the financial institution for this assessment."
    },
    "adjustment_percent": {
      "type": "number",
      "description": "Price adjustment the institution authorises for essentials. Supplied only by a Butter Bank response; the app never calculates or invents it."
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}