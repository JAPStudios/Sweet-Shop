{
  "name": "OrderItem",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "list_price_cents": {
      "type": "number"
    },
    "maker_compensation_cents": {
      "type": "number"
    },
    "is_on_demand": {
      "type": "boolean"
    },
    "lead_time_days": {
      "type": "number"
    }
  },
  "required": [
    "order_id",
    "product_id",
    "title",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}